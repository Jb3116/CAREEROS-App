# Keep these server-side only; never expose secret values to browser bundles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
# Optional: point server-side coding evaluation at a separately deployed, approved
# sandbox provider. It must isolate processes, disable network access, restrict its
# filesystem, and enforce CPU/memory/timeout quotas; never point this at this app.
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=
# Phase 1 uses the transparent deterministic model below. Configure real server-side
# providers only after their access controls, evaluation, and retention policy exist.
AI_PROVIDER=deterministic
LLM_MODEL=
EMBEDDING_PROVIDER=keyword-overlap
EMBEDDING_MODEL=
CODE_ANALYSIS_PROVIDER=
AI_DEBUG=false
# Optional controlled-demo deadline, e.g. 2026-09-01T10:00:00+05:30.
DEMO_OPPORTUNITY_DEADLINE=
